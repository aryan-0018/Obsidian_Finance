NODE_ENV=production
PORT=8000
BASE_PATH=/api

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/obsidian-finance?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Receipt & Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Service (Primary)
RESEND_API_KEY=your_resend_api_key_here
RESEND_MAILER_SENDER=onboarding@resend.dev

# Nodemailer SMTP Service (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SENDER="Obsidian Finance" <your_email@gmail.com>

# Client URL (CORS)
FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Telegram Copilot Bot 
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Self-Ping Keep-Alive URL (prevents free-tier host spin-down, e.g. on Render)
SERVER_URL=https://your-backend-api.onrender.com


